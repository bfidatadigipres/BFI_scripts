# /etc/adlib-gateway/adlib-gateway.env
# Environment for the adlib_gateway systemd service (the gateway host only).
# Install with:  sudo install -m 0640 adlib-gateway.env /etc/adlib-gateway/
# Keep the token secret; chmod 0640 and chown root:systemd-journal or similar.

# Address gunicorn binds to. Use the LAN IP/hostname so remote servers reach it.
ADLIB_GW_BIND=0.0.0.0:8080

# Shared secret. MUST match ADLIB_GATEWAY_TOKEN on every client server.
# Generate one with:  openssl rand -hex 32
ADLIB_GATEWAY_TOKEN=CHANGE_ME_run_openssl_rand_hex_32

# Optional: point at a config.json other than the one beside app.py
#ADLIB_GW_CONFIG=/home/whitej/git/BFI_scripts/adlib_gateway/gateway/config.json

# Optional runtime overrides (otherwise taken from config.json):
#ADLIB_GW_WRITER_WORKERS=1
#ADLIB_GW_READER_WORKERS=3
#ADLIB_GW_MAX_QUEUE_DEPTH=500
#ADLIB_GW_LOG_FILE=/var/log/adlib-gateway/gateway.log

# Optional: comma-separated allowlist of permitted Axiell hostnames.
# Strongly recommended on a shared network. Example:
#ADLIB_GW_ALLOWED_HOSTS=cid-api.internal,cid-api2.internal
